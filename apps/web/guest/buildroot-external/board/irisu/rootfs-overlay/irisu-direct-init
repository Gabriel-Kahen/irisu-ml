#!/bin/sh
export HOME=/root
export PATH=/sbin:/usr/sbin:/bin:/usr/bin

fail() {
  printf '__IRISU_GUEST_ERROR__:%s\n' "$1"
  exit 1
}

mkdir -p /mnt
mount -t proc proc /proc || fail mount-proc
mount -t 9p -o trans=virtio,version=9p2000.L,cache=loose host9p /mnt || fail mount-9p
for file in irisu-exact-worker libirisu_box2d_msvc_exact_multiworld.so \
  libstdc++.so.6; do
  [ -s "/mnt/$file" ] || fail "missing-$file"
done
chmod +x /mnt/irisu-exact-worker
cd /
[ -c /dev/hvc0 ] || mknod /dev/hvc0 c 229 0 || fail create-hvc0
exec 3<>/dev/hvc0 || fail open-hvc0
stty raw -echo <&3 || fail configure-hvc0
printf '\137\137IRISU\137RPC\137READY\137\137'
IRISU_EXACT_CW=0x27f exec /mnt/irisu-exact-worker <&3 >&3 3>&-
